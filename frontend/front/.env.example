# Front standalone server
FRONT_PORT=9090
HOST_API_BASE=http://localhost:9000

# AI provider: ollama | gemini | openai | deepseek
AI_PROVIDER=deepseek

# Ollama
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gpt-oss:20b
# OLLAMA_ENDPOINT=
# OLLAMA_WIRE_API=
# OLLAMA_API_KEY=
# OLLAMA_TIMEOUT_SEC=180

# Gemini
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_ENDPOINT=
# GEMINI_TIMEOUT_SEC=45

# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_CHAT_ENDPOINT=
# OPENAI_TIMEOUT_SEC=35

# DeepSeek
# DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=true
DEEPSEEK_REASONING_EFFORT=high
# DEEPSEEK_CHAT_ENDPOINT=
# DEEPSEEK_TIMEOUT_SEC=180
# AI_STRATEGY_DEEPSEEK_TIMEOUT_SEC=240

# Strategy validation / runtime artifact generation
AI_STRATEGY_VALIDATE_MAX_ATTEMPTS=50
AI_STRATEGY_VALIDATE_TIMEOUT_SEC=60
AI_STRATEGY_WRITE_RUNTIME_ARTIFACTS=true
AI_STRATEGY_ARTIFACT_DIR=examples/strategy-runner/generated

# EVM protocol knowledge ingestion / RAG DB
# Etherscan API V2 endpoint: https://api.etherscan.io/v2/api
# Base Mainnet chainid=8453. Base Sepolia chainid=84532.
# "YourApiKeyToken" in docs is an example placeholder, not a real key.
# If a real API key was exposed in chat, logs, or GitHub, delete it and rotate.
# ETHERSCAN_API_KEY is preferred for Etherscan API V2.
# BASESCAN_API_KEY is accepted as a local alias for existing BaseScan-style env setups.
# ETHERSCAN_API_KEY=
# BASESCAN_API_KEY=
BASE_RPC_URL=https://mainnet.base.org
# Optional: prefer WebSocket streaming when you have a provider WSS endpoint.
# BASE_WS_URL=
# BASE_MAINNET_RPC_URL=
# BASE_MAINNET_WS_URL=
# BASE_SEPOLIA_RPC_URL=
# BASE_SEPOLIA_WS_URL=
# EVM_RPC_URL=
# EVM_WS_URL=
EVM_KNOWLEDGE_DB=.local/evm-protocol-knowledge.sqlite
EVM_KNOWLEDGE_DOCS_DIR=docs/rag/evm-protocols

# Entity-centric Hybrid Retrieval Graph DB
# Requires PostgreSQL with pgvector installed.
KG_DATABASE_URL=postgres://postgres:postgres@localhost:5433/hershy_kg
# KG_DATABASE_SSL=
# KG_DATABASE_POOL_SIZE=8
KG_EMBEDDING_PROVIDER=ollama
KG_OLLAMA_BASE_URL=http://localhost:11434
KG_EMBEDDING_MODEL=nomic-embed-text
# OpenAI provider only. Local Ollama dimensions are detected from returned vectors.
# KG_EMBEDDING_DIM=1536
# KG_EMBEDDING_QUERY_PREFIX=
# KG_EMBEDDING_DOCUMENT_PREFIX=
# KG_EMBEDDING_MAX_INPUT_TOKENS=
# KG_HNSW_M=16
# KG_HNSW_EF_CONSTRUCTION=64

# Agentic workflow web discovery
# Default provider is duckduckgo, which needs no key but is best-effort.
# For production, prefer Brave/Tavily/Serper and set the corresponding key.
AGENT_WEB_SEARCH_PROVIDER=duckduckgo
# AGENT_WEB_SEARCH_ENABLED=true
# AGENT_WEB_QUERY_LIMIT=4
# AGENT_WEB_SEARCH_TIMEOUT_MS=8000
# AGENT_WEB_FETCH_PAGES=true
# AGENT_WEB_PAGE_FETCH_LIMIT=4
# AGENT_WEB_PAGE_FETCH_TIMEOUT_MS=8000
# BRAVE_SEARCH_API_KEY=
# TAVILY_API_KEY=
# SERPER_API_KEY=

# Agentic contract reasoning
# Uses the normal AI provider layer, but can be overridden with AI_CONTRACT_REASONING_* env vars.
AGENT_CONTRACT_REASONING_ENABLED=true
# AGENT_CONTRACT_REASONING_CHUNK_LIMIT=18
# AI_CONTRACT_REASONING_PROVIDER=deepseek
# AI_CONTRACT_REASONING_MODEL=deepseek-v4-flash

# Persist agentic workflow runs into the KG Postgres DB.
AGENT_WORKFLOW_PERSIST_RUNS=true
