# Front standalone server
FRONT_PORT=9090
HOST_API_BASE=http://localhost:9000

# AI provider: ollama | gemini | openai | deepseek
AI_PROVIDER=deepseek

# Ollama
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gpt-oss:20b
# OLLAMA_ENDPOINT=
# OLLAMA_WIRE_API=
# OLLAMA_API_KEY=
# OLLAMA_TIMEOUT_SEC=180

# Gemini
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_ENDPOINT=
# GEMINI_TIMEOUT_SEC=45

# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_CHAT_ENDPOINT=
# OPENAI_TIMEOUT_SEC=35

# DeepSeek
# DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=true
DEEPSEEK_REASONING_EFFORT=high
# DEEPSEEK_CHAT_ENDPOINT=
# DEEPSEEK_TIMEOUT_SEC=180
# AI_STRATEGY_DEEPSEEK_TIMEOUT_SEC=240

# Strategy validation / runtime artifact generation
AI_STRATEGY_VALIDATE_MAX_ATTEMPTS=50
AI_STRATEGY_VALIDATE_TIMEOUT_SEC=60
AI_STRATEGY_WRITE_RUNTIME_ARTIFACTS=true
AI_STRATEGY_ARTIFACT_DIR=examples/strategy-runner/generated
