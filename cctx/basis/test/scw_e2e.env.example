# Copy the values you need into cctx/.env or export them in your shell.
# Do not commit real private keys, session keys, relayer tokens, or RPC secrets.

# Enables read-only SCW DEX preflight.
CCTX_LIVE_SCW_DEX=1

# EVM/BSC connection.
EVM_DEX_RPC_URL=https://bsc-dataseed.binance.org
EVM_DEX_CHAIN_ID=56
EVM_DEX_NATIVE_SYMBOL=BNB

# Generic SCW/session-key mode. Privy is intentionally not required here.
EVM_DEX_SIGNER_TYPE=session_key
EVM_DEX_SMART_WALLET_ADDRESS=REPLACE_WITH_SCW_ADDRESS
EVM_DEX_SESSION_PRIVATE_KEY=REPLACE_WITH_SESSION_KEY_PRIVATE_KEY
EVM_DEX_SESSION_KEY_ID=REPLACE_WITH_SESSION_KEY_ID
EVM_DEX_POLICY_ID=REPLACE_WITH_POLICY_ID
EVM_DEX_RELAYER_URL=REPLACE_WITH_RELAYER_URL
EVM_DEX_RELAYER_AUTH_TOKEN=REPLACE_WITH_RELAYER_AUTH_TOKEN
EVM_DEX_SESSION_DEADLINE_SECONDS=300

# Uniswap V3 on BNB Chain.
UNISWAP_V3_QUOTER=0x78D78E420Da98ad378D7799bE8f4AF69033EB077
UNISWAP_V3_ROUTER=0xB971eF87ede563556b2ED4b1C0b0019111Dd85d2
# Deployed UniswapV3SinglePairAdapter. Required only for adapter E2E.
SCW_DEX_UNISWAP_V3_ADAPTER=REPLACE_WITH_ADAPTER_ADDRESS

# Trade inputs. Use a tiny amount while testing.
BASIS_CHAIN=bsc
BASIS_ASSET=ETH
BASIS_TOKEN_ADDRESS=0x2170Ed0880ac9A755fd29B2688956BD959F933F8
BASIS_QUOTE_ADDRESS=0x55d398326f99059fF775485246999027B3197955
BASIS_QUOTE_SYMBOL=USDT
BASIS_POOL_ADDRESS=0xdE67D05242B18AF00b28678dB34FEEC883cc9Cd6
UNISWAP_V3_FEE=0
BASIS_AMOUNT_IN_WEI=REPLACE_WITH_USDT_WEI_AMOUNT
BASIS_SLIPPAGE_BPS=100
BASIS_EXIT_SLIPPAGE_BPS=100

# Approval spender is the direct DEX router for the legacy router E2E.
# For adapter E2E, the test overrides the spender to SCW_DEX_UNISWAP_V3_ADAPTER.
SCW_DEX_APPROVAL_SPENDER=
SCW_DEX_REQUIRE_PREAPPROVED=false

# Real SCW tx gate. Keep disabled for read-only preflight.
CCTX_LIVE_SCW_DEX_ALLOW_TX=0
CCTX_LIVE_SCW_DEX_RISK_ACK=
ENABLE_LIVE_TRADING=false
DRY_RUN=true

# E2E behavior.
# Default false means the test swaps quote -> token and then token -> quote.
SCW_DEX_SKIP_EXIT=false
# Optional recovery override. If empty, recovery exits the SCW's full token balance.
SCW_DEX_EXIT_AMOUNT_IN_WEI=

# Relayer/on-chain policy must allow these calls for full round-trip:
# Legacy router E2E:
# - quote token target + approve(address,uint256) selector 0x095ea7b3
# - output token target + approve(address,uint256) selector 0x095ea7b3
# - Uniswap V3 router target + exactInputSingle(...) selector 0x04e45aaf
#
# Adapter E2E MVP:
# - quote token target + approve(address,uint256) selector 0x095ea7b3
# - output token target + approve(address,uint256) selector 0x095ea7b3
# - UniswapV3SinglePairAdapter target + openPosition(uint256,uint256) selector 0x3012b05c
# - UniswapV3SinglePairAdapter target + closePosition(uint256,uint256) selector 0x2d6ce61d
# - UniswapV3SinglePairAdapter target + emergencyExit(uint256) selector 0x4231b0bd
#
# Final UX should move token approvals into user-approved onboarding Safe actions,
# then the session policy can allow only the adapter target/selectors.
