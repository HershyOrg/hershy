# Copy the values you need into cctx/.env or export them in your shell.
# Do not commit real private keys or API secrets.

# Enables read-only live preflight.
CCTX_LIVE_BASIS=1

# EVM/BSC connection.
EVM_DEX_RPC_URL=https://bsc-dataseed.binance.org
EVM_DEX_CHAIN_ID=56
EVM_DEX_CAST_BINARY=cast

# DEX signer mode. Use "eoa" for direct EOA swaps, or "session_key" for SCW relayer swaps.
EVM_DEX_SIGNER_TYPE=eoa

# EOA mode: PRIVATE_KEY is used to derive the wallet for allowance checks and to sign swaps.
EVM_DEX_PRIVATE_KEY=REPLACE_WITH_PRIVATE_KEY

# SCW mode: uncomment/fill these and set EVM_DEX_SIGNER_TYPE=session_key.
# EVM_DEX_SMART_WALLET_ADDRESS=REPLACE_WITH_SCW_ADDRESS
# EVM_DEX_SESSION_PRIVATE_KEY=REPLACE_WITH_SESSION_KEY_PRIVATE_KEY
# EVM_DEX_SESSION_KEY_ID=REPLACE_WITH_SESSION_KEY_ID
# EVM_DEX_POLICY_ID=REPLACE_WITH_POLICY_ID
# EVM_DEX_RELAYER_URL=REPLACE_WITH_RELAYER_URL
# EVM_DEX_RELAYER_AUTH_TOKEN=REPLACE_WITH_RELAYER_AUTH_TOKEN
# EVM_DEX_SESSION_DEADLINE_SECONDS=300

# Uniswap V3 on BNB Chain.
UNISWAP_V3_QUOTER=0x78D78E420Da98ad378D7799bE8f4AF69033EB077
UNISWAP_V3_ROUTER=0xB971eF87ede563556b2ED4b1C0b0019111Dd85d2

# Trade inputs. Use a tiny amount while testing.
BASIS_CHAIN=bsc
BASIS_ASSET=REPLACE_WITH_ASSET_SYMBOL
BASIS_TOKEN_ADDRESS=REPLACE_WITH_BASE_TOKEN
BASIS_QUOTE_ADDRESS=0x55d398326f99059fF775485246999027B3197955
BASIS_QUOTE_SYMBOL=USDT
BASIS_POOL_ADDRESS=REPLACE_WITH_UNISWAP_V3_POOL
# Optional if pool is provided; otherwise required.
UNISWAP_V3_FEE=0
BASIS_AMOUNT_IN_WEI=REPLACE_WITH_USDT_WEI_AMOUNT
BASIS_SLIPPAGE_BPS=100
BASIS_EXIT_SLIPPAGE_BPS=100

# Binance USD-M futures.
BINANCE_API_KEY=REPLACE_WITH_BINANCE_API_KEY
BINANCE_API_SECRET=REPLACE_WITH_BINANCE_API_SECRET
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
BINANCE_RECV_WINDOW=5000
BINANCE_LEVERAGE=1
BASIS_FUTURES_SYMBOL=REPLACE_WITH_SYMBOL_USDT
BASIS_FUTURES_QUANTITY=REPLACE_WITH_FUTURES_QTY

# Real order gate. Keep these disabled for read-only preflight.
CCTX_LIVE_BASIS_ALLOW_ORDERS=0
CCTX_LIVE_BASIS_RISK_ACK=
ENABLE_LIVE_TRADING=false
DRY_RUN=true
BASIS_STATE_FILE=bot/state/cctx_live_basis_positions.json

# Keep true unless you have explicitly decided to let the test submit approvals.
BASIS_REQUIRE_PREAPPROVED=true
